{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hero": {
      "type": "object",
      "properties": {
        "badge": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "highlightTitle": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "primaryCta": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "href"
          ]
        },
        "secondaryCta": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "href"
          ]
        },
        "image": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "src",
            "alt",
            "width",
            "height"
          ]
        }
      },
      "required": [
        "title",
        "subtitle",
        "primaryCta",
        "image"
      ]
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "label"
        ]
      }
    },
    "featuresHeading": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        }
      },
      "required": [
        "eyebrow",
        "title",
        "subtitle"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "badge": {
            "type": "string"
          },
          "metrics": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "icon"
        ]
      }
    },
    "testimonial": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "avatar": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "src",
            "alt",
            "width",
            "height"
          ]
        }
      },
      "required": [
        "quote",
        "author",
        "role",
        "company",
        "avatar"
      ]
    },
    "ctaBanner": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "buttonText": {
          "type": "string"
        },
        "buttonHref": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "subtitle",
        "buttonText",
        "buttonHref"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "hero"
  ]
}