---
const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Product', href: '/product' },
  { name: 'Pricing', href: '/pricing' },
  { name: 'Contact', href: '/contact' },
];

function isActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-neutral-800 bg-neutral-950/80 backdrop-blur-md transition-all">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a 
      href="/" 
      class="group flex items-center gap-2.5 text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 rounded-lg p-1"
      aria-label="NexFlow Home"
    >
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500 text-neutral-950 font-bold shadow-sm transition-transform group-hover:scale-105">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <span class="text-xl font-bold tracking-tight text-white">
        NexFlow<span class="text-emerald-500">.</span> <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full ml-1 hidden sm:inline-block">B2B</span>
      </span>
    </a>

    <!-- Desktop Main Navigation -->
    <nav aria-label="Main Navigation" class="hidden md:flex md:items-center md:gap-8">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  'relative py-1.5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 rounded-md px-2',
                  active
                    ? 'font-semibold text-emerald-400'
                    : 'text-neutral-400 hover:text-emerald-400'
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {item.name}
                {active && (
                  <span class="absolute inset-x-2 -bottom-1 h-0.5 rounded-full bg-emerald-500" />
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="hidden items-center gap-4 md:flex">
      <a
        href="/contact"
        class="text-sm font-medium text-neutral-300 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 rounded-md px-3 py-2"
      >
        Sign In
      </a>
      <a
        href="/pricing"
        class="inline-flex items-center justify-center rounded-full bg-neutral-100 px-5 py-2 text-sm font-bold text-neutral-950 shadow-sm hover:bg-emerald-400 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 active:scale-95"
      >
        Start Free Trial
      </a>
    </div>

    <!-- Mobile Menu Toggle (Pure HTML details/summary zero-JS) -->
    <details class="group relative md:hidden">
      <summary 
        class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-neutral-800 bg-neutral-900 text-neutral-300 hover:bg-neutral-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 list-none"
        aria-label="Toggle Navigation Menu"
      >
        <svg class="h-6 w-6 group-open:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-6 w-6 group-open:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </summary>

      <!-- Mobile Dropdown Menu -->
      <div class="absolute right-0 top-12 z-50 w-64 rounded-xl border border-neutral-800 bg-neutral-900 p-4 shadow-2xl ring-1 ring-white/10 animate-in fade-in slide-in-from-top-2">
        <nav aria-label="Mobile Navigation">
          <ul class="flex flex-col gap-2">
            {navItems.map((item) => {
              const active = isActive(item.href);
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'block rounded-lg px-3 py-2 text-base font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500',
                      active
                        ? 'bg-emerald-500/10 font-semibold text-emerald-400 border border-emerald-500/20'
                        : 'text-neutral-300 hover:bg-neutral-800 hover:text-white'
                    ]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {item.name}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
        <div class="mt-4 border-t border-neutral-800 pt-4 flex flex-col gap-2">
          <a
            href="/contact"
            class="block w-full rounded-lg border border-neutral-800 px-3 py-2 text-center text-sm font-medium text-neutral-300 hover:bg-neutral-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
          >
            Sign In
          </a>
          <a
            href="/pricing"
            class="block w-full rounded-lg bg-emerald-500 px-3 py-2 text-center text-sm font-bold text-neutral-950 hover:bg-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
          >
            Start Free Trial
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
