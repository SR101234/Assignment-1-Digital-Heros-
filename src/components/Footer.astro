---
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'Platform',
    links: [
      { name: 'Architecture Overview', href: '/product' },
      { name: 'Core Engine Specifications', href: '/product#specs' },
      { name: '300+ Enterprise Connectors', href: '/product#integrations' },
      { name: 'Release Notes v4.2', href: '/product' },
    ],
  },
  {
    title: 'Plans & Billing',
    links: [
      { name: 'Developer Starter', href: '/pricing#starter' },
      { name: 'Growth Pro', href: '/pricing#pro' },
      { name: 'Custom Enterprise', href: '/pricing#enterprise' },
      { name: 'Pricing FAQ', href: '/pricing#faq' },
    ],
  },
  {
    title: 'Company',
    links: [
      { name: 'About NexFlow', href: '/' },
      { name: 'Contact Sales', href: '/contact' },
      { name: 'Engineering Blog', href: '/product' },
      { name: 'Customer Case Studies', href: '/' },
    ],
  },
  {
    title: 'Security & Compliance',
    links: [
      { name: 'SOC2 Type II Portal', href: '/contact' },
      { name: 'Privacy Policy', href: '/contact' },
      { name: 'Terms of Service', href: '/contact' },
      { name: 'Security Advisory', href: '/contact' },
    ],
  },
];
---

<footer class="border-t border-neutral-800 bg-neutral-900 text-neutral-400">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-5">
      <!-- Brand & Organization Details -->
      <div class="lg:col-span-2">
        <a 
          href="/" 
          class="group inline-flex items-center gap-2.5 text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 rounded-lg"
          aria-label="NexFlow Home"
        >
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500 text-neutral-950 font-bold shadow-sm">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight text-white">NexFlow<span class="text-emerald-500">.</span> Enterprise</span>
        </a>
        
        <p class="mt-4 max-w-sm text-sm text-neutral-400 leading-relaxed">
          The sub-millisecond B2B workflow orchestration platform built for mission-critical enterprise engineering and data operations.
        </p>

        <div class="mt-6 text-xs text-neutral-400 space-y-1">
          <p class="font-medium text-neutral-300">NexFlow Technologies Inc.</p>
          <p>500 Howard Street, Suite 400</p>
          <p>San Francisco, CA 94105, United States</p>
          <p class="pt-1"><span class="text-neutral-500">Sales:</span> enterprise@nexflow-demo.com</p>
        </div>
      </div>

      <!-- Navigation Columns -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:col-span-3">
        {footerSections.map((section) => (
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wider text-neutral-200">
              {section.title}
            </h2>
            <ul class="mt-4 space-y-2.5">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-neutral-400 hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 rounded-md py-0.5"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 border-t border-neutral-800 pt-8 flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="text-xs text-neutral-500">
        &copy; {currentYear} NexFlow Technologies Inc. All rights reserved. Sub-millisecond pipeline orchestration engine.
      </p>

      <div class="flex items-center gap-6 text-neutral-400">
        <a 
          href="https://github.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded-md p-1"
          aria-label="GitHub Repository"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>
        <a 
          href="https://twitter.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded-md p-1"
          aria-label="X Twitter"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
