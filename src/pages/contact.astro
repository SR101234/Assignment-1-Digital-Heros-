---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const contactEntry = await getEntry('pages', 'contact');

if (!contactEntry) {
  throw new Error('Contact page entry missing from content collection src/content/pages/contact.md');
}

const { title, description, keywords, hero, stats, ctaBanner } = contactEntry.data;
const { Content } = await render(contactEntry);

// Organization Schema.org JSON-LD with ContactPoint
const contactOrganizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'NexFlow Technologies Inc.',
  url: Astro.url.href,
  logo: new URL('/favicon.svg', Astro.url).href,
  description: description,
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+1-800-555-0199',
      contactType: 'sales',
      email: 'enterprise@nexflow-demo.com',
      availableLanguage: ['English'],
    },
    {
      '@type': 'ContactPoint',
      telephone: '+1-800-555-0198',
      contactType: 'technical support',
      email: 'support@nexflow-demo.com',
      availableLanguage: ['English'],
    },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '500 Howard Street, Suite 400',
    addressLocality: 'San Francisco',
    addressRegion: 'CA',
    postalCode: '94105',
    addressCountry: 'US',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  schemaJsonLd={contactOrganizationSchema}
>
  <!-- Hero Section -->
  <section class="bg-neutral-950 pt-12 pb-20 text-white lg:pt-20 lg:pb-28 border-b border-neutral-800 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-neutral-800/20 via-transparent to-transparent">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          {hero.badge && (
            <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-400">
              {hero.badge}
            </span>
          )}

          <h1 class="mt-6 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-white">
            {hero.title}{' '}
            {hero.highlightTitle && (
              <span class="text-neutral-500 italic block sm:inline">
                {hero.highlightTitle}
              </span>
            )}
          </h1>

          <p class="mt-6 text-lg text-neutral-400 leading-relaxed max-w-2xl">
            {hero.subtitle}
          </p>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href="#contact-form"
              class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-6 py-3.5 text-base font-bold text-neutral-950 shadow-lg shadow-emerald-500/20 hover:bg-emerald-400 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 active:scale-95"
            >
              Send Message
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-2 shadow-2xl">
            <img
              src={hero.image.src}
              alt={hero.image.alt}
              width={hero.image.width}
              height={hero.image.height}
              loading="eager"
              fetchpriority="high"
              class="w-full h-auto rounded-xl object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Metrics / Response SLA -->
  {stats && (
    <section class="bg-neutral-900 text-white py-10 border-b border-neutral-800" aria-label="Support Guarantees">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
          {stats.map((stat) => (
            <div class="text-center md:text-left">
              <p class="text-3xl font-extrabold text-white tracking-tight">{stat.value}</p>
              <p class="mt-1 text-xs font-bold uppercase tracking-wider text-neutral-400">{stat.label}</p>
              {stat.description && <p class="mt-0.5 text-xs text-neutral-500">{stat.description}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Contact Form & Details Section -->
  <section id="contact-form" class="py-20 bg-neutral-950" aria-labelledby="form-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- B2B Enterprise Lead Form -->
        <div class="lg:col-span-7">
          <div class="rounded-3xl border border-neutral-800 bg-neutral-900 p-8 shadow-xl">
            <h2 id="form-heading" class="text-2xl font-bold text-white sm:text-3xl">
              Talk to an Enterprise Specialist
            </h2>
            <p class="mt-2 text-sm text-neutral-400">
              Fill out the form below and a Senior Solutions Architect will reach out within 15 minutes.
            </p>

            <form class="mt-8 space-y-6" action="#" method="POST" onsubmit="event.preventDefault(); alert('Thank you for contacting NexFlow Enterprise. A Solutions Architect will be in touch shortly.');">
              <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div>
                  <label for="first-name" class="block text-sm font-semibold text-neutral-200">
                    First Name <span class="text-emerald-400">*</span>
                  </label>
                  <input
                    type="text"
                    name="first-name"
                    id="first-name"
                    autocomplete="given-name"
                    required
                    class="mt-2 block w-full rounded-xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-white placeholder-neutral-500 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
                    placeholder="Jane"
                  />
                </div>

                <div>
                  <label for="last-name" class="block text-sm font-semibold text-neutral-200">
                    Last Name <span class="text-emerald-400">*</span>
                  </label>
                  <input
                    type="text"
                    name="last-name"
                    id="last-name"
                    autocomplete="family-name"
                    required
                    class="mt-2 block w-full rounded-xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-white placeholder-neutral-500 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
                    placeholder="Doe"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div>
                  <label for="work-email" class="block text-sm font-semibold text-neutral-200">
                    Work Email <span class="text-emerald-400">*</span>
                  </label>
                  <input
                    type="email"
                    name="work-email"
                    id="work-email"
                    autocomplete="email"
                    required
                    class="mt-2 block w-full rounded-xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-white placeholder-neutral-500 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
                    placeholder="jane@company.com"
                  />
                </div>

                <div>
                  <label for="company-name" class="block text-sm font-semibold text-neutral-200">
                    Company Name <span class="text-emerald-400">*</span>
                  </label>
                  <input
                    type="text"
                    name="company-name"
                    id="company-name"
                    autocomplete="organization"
                    required
                    class="mt-2 block w-full rounded-xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-white placeholder-neutral-500 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
                    placeholder="Acme Corp"
                  />
                </div>
              </div>

              <div>
                <label for="execution-volume" class="block text-sm font-semibold text-neutral-200">
                  Estimated Monthly Execution Volume
                </label>
                <select
                  id="execution-volume"
                  name="execution-volume"
                  class="mt-2 block w-full rounded-xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-white shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
                >
                  <option value="under-1m" class="bg-neutral-900 text-white">&lt; 1 Million Executions / mo</option>
                  <option value="1m-10m" class="bg-neutral-900 text-white">1M - 10M Executions / mo</option>
                  <option value="10m-100m" class="bg-neutral-900 text-white">10M - 100M Executions / mo</option>
                  <option value="100m-plus" class="bg-neutral-900 text-white">100M+ Executions / mo (Custom Enterprise)</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-semibold text-neutral-200">
                  Architecture Requirements & Use Case Description
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  class="mt-2 block w-full rounded-xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-white placeholder-neutral-500 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
                  placeholder="Tell us about your current automation stack, data volume, and compliance requirements..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full rounded-full bg-emerald-500 px-6 py-4 text-center text-base font-bold text-neutral-950 shadow-lg hover:bg-emerald-400 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 active:scale-95"
              >
                Submit Consultation Request
              </button>
            </form>
          </div>
        </div>

        <!-- Global Headquarters & Direct Lines -->
        <div class="lg:col-span-5 flex flex-col gap-8">
          <div class="rounded-3xl border border-neutral-800 bg-neutral-900 p-8 shadow-md">
            <h3 class="text-xl font-bold text-white">Global Offices</h3>
            <ul class="mt-6 space-y-6 text-sm text-neutral-400">
              <li class="border-b border-neutral-800 pb-4">
                <p class="font-bold text-white">San Francisco Headquarters</p>
                <p class="mt-1">500 Howard Street, Suite 400</p>
                <p>San Francisco, CA 94105, USA</p>
                <p class="mt-2 text-xs font-semibold text-emerald-400">+1 (800) 555-0199</p>
              </li>
              <li class="border-b border-neutral-800 pb-4">
                <p class="font-bold text-white">London Regional Hub</p>
                <p class="mt-1">30 St Mary Axe, Floor 18</p>
                <p>London EC3A 8EP, United Kingdom</p>
                <p class="mt-2 text-xs font-semibold text-emerald-400">+44 20 7946 0912</p>
              </li>
              <li>
                <p class="font-bold text-white">Singapore APAC Center</p>
                <p class="mt-1">1 Raffles Place, Tower 2</p>
                <p>Singapore 048616</p>
                <p class="mt-2 text-xs font-semibold text-emerald-400">+65 6789 0123</p>
              </li>
            </ul>
          </div>

          <div class="rounded-3xl border border-emerald-500/20 bg-emerald-500/10 p-8">
            <h3 class="text-lg font-bold text-white">Security & Security Incident Escalation</h3>
            <p class="mt-2 text-sm text-neutral-300 leading-relaxed">
              For security vulnerability disclosures or critical SOC2 compliance validation requests, email <a href="mailto:security@nexflow-demo.com" class="font-bold text-emerald-400 underline hover:text-emerald-300">security@nexflow-demo.com</a> directly.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Narrative content from contact.md -->
  <section class="py-12 bg-neutral-900 border-t border-neutral-800">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 prose prose-invert prose-emerald">
      <Content />
    </div>
  </section>

  <!-- CTA Banner -->
  {ctaBanner && (
    <section class="py-16 bg-neutral-950 text-white text-center border-t border-neutral-800">
      <div class="mx-auto max-w-4xl px-4">
        <h2 class="text-3xl font-extrabold text-white">{ctaBanner.title}</h2>
        <p class="mt-3 text-neutral-400">{ctaBanner.subtitle}</p>
        <a
          href={ctaBanner.buttonHref}
          class="mt-6 inline-block rounded-full bg-emerald-500 px-8 py-3.5 text-sm font-bold text-neutral-950 shadow-lg hover:bg-emerald-400 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
        >
          {ctaBanner.buttonText}
        </a>
      </div>
    </section>
  )}
</BaseLayout>
