---
import { getEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch page content and data collections
const pricingEntry = await getEntry('pages', 'pricing');

if (!pricingEntry) {
  throw new Error('Pricing page entry missing from content collection src/content/pages/pricing.md');
}

const { title, description, keywords, hero, featuresHeading, features, ctaBanner } = pricingEntry.data;
const { Content } = await render(pricingEntry);

const pricingTiersRaw = await getCollection('pricing');
const pricingTiers = pricingTiersRaw.sort((a, b) => a.data.priceMonthly - b.data.priceMonthly);

const faqsRaw = await getCollection('faqs');
const faqs = faqsRaw.sort((a, b) => a.data.id.localeCompare(b.data.id));

// Combined Schema.org JSON-LD: SoftwareApplication & FAQPage
const schemaJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'NexFlow Platform',
    operatingSystem: 'Cloud Native',
    applicationCategory: 'BusinessApplication',
    offers: pricingTiers.map((tier) => ({
      '@type': 'Offer',
      name: tier.data.name,
      price: tier.data.priceMonthly,
      priceCurrency: 'USD',
      description: tier.data.tagline,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.data.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.data.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  schemaJsonLd={schemaJsonLd}
>
  <!-- Hero Section -->
  <section class="bg-neutral-950 pt-12 pb-20 text-white lg:pt-20 lg:pb-28 border-b border-neutral-800 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-neutral-800/20 via-transparent to-transparent">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          {hero.badge && (
            <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-400">
              {hero.badge}
            </span>
          )}

          <h1 class="mt-6 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-white">
            {hero.title}{' '}
            {hero.highlightTitle && (
              <span class="text-neutral-500 italic block sm:inline">
                {hero.highlightTitle}
              </span>
            )}
          </h1>

          <p class="mt-6 text-lg text-neutral-400 leading-relaxed max-w-2xl">
            {hero.subtitle}
          </p>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href={hero.primaryCta.href}
              class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-6 py-3.5 text-base font-bold text-neutral-950 shadow-lg shadow-emerald-500/20 hover:bg-emerald-400 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 active:scale-95"
            >
              {hero.primaryCta.text}
            </a>
            {hero.secondaryCta && (
              <a
                href={hero.secondaryCta.href}
                class="inline-flex items-center justify-center rounded-full border border-neutral-800 bg-neutral-900 px-6 py-3.5 text-base font-medium text-neutral-300 hover:bg-neutral-800 hover:text-white transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
              >
                {hero.secondaryCta.text}
              </a>
            )}
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-2 shadow-2xl">
            <img
              src={hero.image.src}
              alt={hero.image.alt}
              width={hero.image.width}
              height={hero.image.height}
              loading="eager"
              fetchpriority="high"
              class="w-full h-auto rounded-xl object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Cards Grid -->
  <section id="pricing-tiers" class="py-20 bg-neutral-950 relative" aria-label="Pricing Options">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3 items-stretch">
        {pricingTiers.map(({ data }) => (
          <div 
            id={data.id} 
            class:list={[
              'rounded-3xl bg-neutral-900 p-8 shadow-xl flex flex-col justify-between relative transition-all duration-200',
              data.popular
                ? 'border-2 border-emerald-500 ring-2 ring-emerald-500/20 lg:-translate-y-4'
                : 'border border-neutral-800 hover:border-neutral-700'
            ]}
          >
            {data.popular && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-emerald-500 px-4 py-1 text-xs font-extrabold uppercase tracking-widest text-neutral-950 shadow-md">
                Most Popular
              </div>
            )}

            <div>
              <div class="flex items-center justify-between">
                <h2 class="text-2xl font-bold text-white">{data.name}</h2>
              </div>
              <p class="mt-2 text-sm text-neutral-400 leading-relaxed">{data.tagline}</p>

              <div class="mt-6 flex items-baseline gap-1 flex-wrap">
                <span class="text-4xl font-extrabold text-white">{data.currency}{data.priceMonthly}</span>
                <span class="text-sm font-semibold text-neutral-400">/ month</span>
                <span class="ml-2 text-xs text-emerald-400 font-bold bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full">
                  {data.currency}{data.priceAnnual}/mo billed annually
                </span>
              </div>

              <div class="mt-8 border-t border-neutral-800 pt-6">
                <p class="text-xs font-bold uppercase tracking-wider text-neutral-300">What's included:</p>
                <ul class="mt-4 space-y-3 text-sm text-neutral-400">
                  {data.features.map((feat) => (
                    <li class="flex items-start gap-3">
                      {feat.included ? (
                        <svg class="h-5 w-5 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                      ) : (
                        <svg class="h-5 w-5 shrink-0 text-neutral-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                      )}
                      <span class={feat.included ? 'text-neutral-200' : 'text-neutral-600 line-through'}>
                        {feat.name}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-neutral-800">
              <a
                href={data.ctaHref}
                class:list={[
                  'block w-full rounded-full px-4 py-3.5 text-center text-sm font-bold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950',
                  data.popular
                    ? 'bg-emerald-500 text-neutral-950 shadow-md hover:bg-emerald-400 active:scale-95'
                    : 'bg-neutral-800 text-neutral-200 hover:bg-neutral-700 hover:text-white'
                ]}
              >
                {data.ctaText}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Included Guarantees -->
  {featuresHeading && features && (
    <section class="py-16 bg-neutral-900 border-t border-neutral-800">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-400">{featuresHeading.eyebrow}</p>
          <h2 class="mt-2 text-3xl font-extrabold text-white">{featuresHeading.title}</h2>
          <p class="mt-3 text-neutral-400">{featuresHeading.subtitle}</p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
          {features.map((feat) => (
            <div class="rounded-2xl border border-neutral-800 bg-neutral-950 p-6">
              <h3 class="text-lg font-bold text-white">{feat.title}</h3>
              <p class="mt-2 text-sm text-neutral-400">{feat.description}</p>
              {feat.metrics && <p class="mt-4 text-xs font-semibold text-emerald-400">{feat.metrics}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ Section with Schema FAQPage mapping -->
  <section id="faq" class="py-20 bg-neutral-950 border-t border-neutral-800" aria-labelledby="faq-title">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 id="faq-title" class="text-3xl font-extrabold text-white sm:text-4xl">
          Frequently Asked Questions
        </h2>
        <p class="mt-3 text-base text-neutral-400">
          Everything you need to know about billing, enterprise contracts, and deployment options.
        </p>
      </div>

      <div class="mt-12 space-y-6">
        {faqs.map(({ data }) => (
          <details class="group rounded-2xl border border-neutral-800 bg-neutral-900 p-6 shadow-sm transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between font-bold text-white text-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 rounded-md py-1">
              <span>{data.question}</span>
              <span class="ml-4 shrink-0 rounded-full bg-neutral-800 p-1.5 text-neutral-400 group-open:rotate-180 transition-transform">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-4 text-neutral-400 leading-relaxed text-base border-t border-neutral-800 pt-4">
              {data.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Narrative content from pricing.md -->
  <section class="py-12 bg-neutral-900 border-t border-neutral-800">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 prose prose-invert prose-emerald">
      <Content />
    </div>
  </section>

  <!-- CTA Banner -->
  {ctaBanner && (
    <section class="py-16 bg-neutral-950 text-white border-t border-neutral-800">
      <div class="mx-auto max-w-4xl px-4 text-center">
        <h2 class="text-3xl font-extrabold">{ctaBanner.title}</h2>
        <p class="mt-3 text-neutral-400">{ctaBanner.subtitle}</p>
        <a
          href={ctaBanner.buttonHref}
          class="mt-6 inline-block rounded-full bg-emerald-500 px-8 py-3.5 text-sm font-bold text-neutral-950 shadow-lg hover:bg-emerald-400 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
        >
          {ctaBanner.buttonText}
        </a>
      </div>
    </section>
  )}
</BaseLayout>
