---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch content from Astro Content Collection
const homeEntry = await getEntry('pages', 'home');

if (!homeEntry) {
  throw new Error('Home page entry missing from content collection src/content/pages/home.md');
}

const { title, description, keywords, hero, stats, featuresHeading, features, testimonial, ctaBanner } = homeEntry.data;
const { Content } = await render(homeEntry);

// Organization Schema.org JSON-LD
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'NexFlow Technologies Inc.',
  url: Astro.url.href,
  logo: new URL('/favicon.svg', Astro.url).href,
  description: description,
  foundingDate: '2023',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '500 Howard Street, Suite 400',
    addressLocality: 'San Francisco',
    addressRegion: 'CA',
    postalCode: '94105',
    addressCountry: 'US',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+1-800-555-0199',
    contactType: 'customer support',
    email: 'enterprise@nexflow-demo.com',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  schemaJsonLd={organizationSchema}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-neutral-950 pt-12 pb-20 text-white lg:pt-20 lg:pb-28 border-b border-neutral-800 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-neutral-800/20 via-transparent to-transparent">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
        <!-- Hero Copy -->
        <div class="lg:col-span-7">
          {hero.badge && (
            <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold text-emerald-400 backdrop-blur-sm tracking-wide uppercase">
              <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              {hero.badge}
            </div>
          )}

          <!-- Single H1 per page -->
          <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.15]">
            {hero.title}{' '}
            {hero.highlightTitle && (
              <span class="text-neutral-500 italic block sm:inline">
                {hero.highlightTitle}
              </span>
            )}
          </h1>

          <p class="mt-6 text-lg text-neutral-400 sm:text-xl max-w-2xl leading-relaxed">
            {hero.subtitle}
          </p>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
            <a
              href={hero.primaryCta.href}
              class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-6 py-3.5 text-base font-bold text-neutral-950 shadow-lg shadow-emerald-500/20 hover:bg-emerald-400 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 active:scale-95"
            >
              {hero.primaryCta.text}
              <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            {hero.secondaryCta && (
              <a
                href={hero.secondaryCta.href}
                class="inline-flex items-center justify-center rounded-full border border-neutral-800 bg-neutral-900 px-6 py-3.5 text-base font-medium text-neutral-300 hover:bg-neutral-800 hover:text-white transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
              >
                {hero.secondaryCta.text}
              </a>
            )}
          </div>
        </div>

        <!-- Hero Graphic Image (Eager Loading & Explicit Height/Width to prevent CLS) -->
        <div class="lg:col-span-5">
          <div class="relative rounded-2xl border border-neutral-800 bg-neutral-900/80 p-2 shadow-2xl backdrop-blur-xl">
            <img
              src={hero.image.src}
              alt={hero.image.alt}
              width={hero.image.width}
              height={hero.image.height}
              loading="eager"
              fetchpriority="high"
              class="w-full h-auto rounded-xl object-cover shadow-md"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Metrics / Stats Section -->
  {stats && (
    <section class="border-y border-neutral-800 bg-neutral-900 py-12" aria-label="Key Enterprise Metrics">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
          {stats.map((stat) => (
            <div class="text-center md:text-left">
              <p class="text-3xl font-extrabold text-white sm:text-4xl tracking-tight">{stat.value}</p>
              <p class="mt-1 text-xs font-bold uppercase tracking-widest text-neutral-400">{stat.label}</p>
              {stat.description && <p class="mt-0.5 text-xs text-neutral-500">{stat.description}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Features Grid Section -->
  {featuresHeading && features && (
    <section class="py-20 bg-neutral-950" aria-labelledby="features-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-400">{featuresHeading.eyebrow}</p>
          <h2 id="features-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
            {featuresHeading.title}
          </h2>
          <p class="mt-4 text-base text-neutral-400 leading-relaxed">
            {featuresHeading.subtitle}
          </p>
        </div>

        <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-2">
          {features.map((feat) => (
            <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-8 shadow-sm hover:border-neutral-700 transition-colors relative flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between">
                  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    {feat.icon === 'cpu' && (
                      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>
                    )}
                    {feat.icon === 'shield-check' && (
                      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                    )}
                    {feat.icon === 'sparkles' && (
                      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
                    )}
                    {feat.icon === 'network' && (
                      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                    )}
                  </div>
                  {feat.badge && (
                    <span class="rounded-full bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 text-xs font-bold text-emerald-400">
                      {feat.badge}
                    </span>
                  )}
                </div>

                <h3 class="mt-6 text-xl font-bold text-white">{feat.title}</h3>
                <p class="mt-2 text-sm text-neutral-400 leading-relaxed">{feat.description}</p>
              </div>

              {feat.metrics && (
                <div class="mt-6 border-t border-neutral-800 pt-4 flex items-center text-xs font-semibold text-emerald-400">
                  <svg class="mr-1.5 h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
                  {feat.metrics}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Rendered Markdown Content Section -->
  <section class="py-16 bg-neutral-900 border-t border-neutral-800" aria-label="Detailed Narrative">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 prose prose-invert prose-emerald">
      <Content />
    </div>
  </section>

  <!-- Testimonial Section -->
  {testimonial && (
    <section class="py-20 bg-neutral-950 text-white border-t border-neutral-800" aria-labelledby="testimonial-heading">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 id="testimonial-heading" class="sr-only">Customer Testimonial</h2>
        <blockquote class="text-xl font-medium sm:text-2xl lg:text-3xl leading-relaxed text-neutral-200">
          "{testimonial.quote}"
        </blockquote>
        <div class="mt-8 flex items-center justify-center gap-4">
          <img
            src={testimonial.avatar.src}
            alt={testimonial.avatar.alt}
            width={testimonial.avatar.width}
            height={testimonial.avatar.height}
            loading="lazy"
            class="h-14 w-14 rounded-full border-2 border-emerald-500 object-cover shadow-md"
          />
          <div class="text-left">
            <p class="font-bold text-white text-base">{testimonial.author}</p>
            <p class="text-xs text-emerald-400">{testimonial.role}, <span class="font-semibold text-neutral-300">{testimonial.company}</span></p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Banner Section -->
  {ctaBanner && (
    <section class="py-20 bg-neutral-900 text-white border-t border-neutral-800" aria-labelledby="cta-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 id="cta-heading" class="text-3xl font-extrabold sm:text-4xl text-white">
          {ctaBanner.title}
        </h2>
        <p class="mt-4 text-lg text-neutral-400 max-w-2xl mx-auto">
          {ctaBanner.subtitle}
        </p>
        <div class="mt-8 flex justify-center">
          <a
            href={ctaBanner.buttonHref}
            class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-8 py-4 text-base font-bold text-neutral-950 shadow-lg hover:bg-emerald-400 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 active:scale-95"
          >
            {ctaBanner.buttonText}
          </a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
